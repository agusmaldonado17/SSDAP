@using System.ComponentModel.DataAnnotations
@using SSDAP.Shared.DTOs.Usuarios
@using SSDAP.Web.Services
@inherits PanelApiBase
<section class="editor">
    <h2>@(UsuarioId is null ? "Cambiar mi contraseña" : $"Restablecer contraseña · {Nombre}")</h2>
    <p class="muted">Al guardar se cierran las sesiones anteriores de esta cuenta.</p>
    <EstadoOperacion Error="@Error" Mensaje="@Mensaje" Ocupado="Ocupado" />
    <EditForm Model="entrada" OnValidSubmit="GuardarAsync" FormName="password">
        <DataAnnotationsValidator /><ValidationSummary />
        <fieldset disabled="@Ocupado">
        @if (UsuarioId is null)
        { <label for="clave-actual">Contraseña actual</label><InputText id="clave-actual" type="password" autocomplete="current-password" @bind-Value="entrada.Actual" /> }
        <label for="clave-nueva">Nueva contraseña</label><InputText id="clave-nueva" type="password" autocomplete="new-password" maxlength="128" @bind-Value="entrada.Nueva" />
        <label for="clave-confirmacion">Repetir nueva contraseña</label><InputText id="clave-confirmacion" type="password" autocomplete="new-password" maxlength="128" @bind-Value="entrada.Confirmacion" />
        <button class="action-primary" type="submit">Guardar contraseña</button>
        <button type="button" @onclick="Cancelar">Volver</button>
        </fieldset>
    </EditForm>
</section>
@code {
    [Parameter] public int? UsuarioId { get; set; }
    [Parameter] public string Nombre { get; set; } = "";
    [Parameter] public EventCallback Cancelar { get; set; }
    [Parameter] public EventCallback Guardado { get; set; }
    private Entrada entrada = new();
    protected override void OnParametersSet() => entrada.ExigeActual = UsuarioId is null;
    private Task GuardarAsync() => EjecutarAsync(async () =>
    {
        if (UsuarioId is int id)
            await Sesion.EnviarAsync(HttpMethod.Put, $"api/usuarios/{id}/password", new RestablecerPasswordDto { PasswordNueva = entrada.Nueva });
        else
            await Sesion.EnviarAsync(HttpMethod.Put, "api/mi-cuenta/password", new CambiarPasswordDto { PasswordActual = entrada.Actual, PasswordNueva = entrada.Nueva });
        entrada = new() { ExigeActual = UsuarioId is null };
        if (UsuarioId is null || UsuarioId == Sesion.Actual!.Usuario.IdUsuario)
        { await Sesion.LimpiarAsync(); await SesionVencida.InvokeAsync(); }
        else { Mensaje = "Contraseña actualizada."; }
        await Guardado.InvokeAsync();
    });
    public sealed class Entrada : IValidatableObject
    {
        public bool ExigeActual { get; set; }
        [StringLength(128)] public string Actual { get; set; } = "";
        [Required(ErrorMessage = "Ingresá la contraseña nueva."), StringLength(128)] public string Nueva { get; set; } = "";
        [Compare(nameof(Nueva), ErrorMessage = "Las contraseñas no coinciden.")] public string Confirmacion { get; set; } = "";
        public IEnumerable<ValidationResult> Validate(ValidationContext context)
        { if (ExigeActual && string.IsNullOrWhiteSpace(Actual)) yield return new("Ingresá la contraseña actual.", [nameof(Actual)]); }
    }
}
