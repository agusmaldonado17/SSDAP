@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Sections
<a class="skip-link" href="#contenido">Ir al contenido</a>
<header class="institutional-header">
    <a class="header-brand" href="/" aria-label="SSDAP · Inicio"><img src="brand/adc-compacto.jpg" alt="ADC" width="2658" height="678" /></a>
    <div class="header-actions">
        <button class="menu-toggle" aria-controls="menu-lateral" aria-expanded="@menuVisible" @onclick="() => menuVisible = !menuVisible">Menú</button>
        <SectionOutlet SectionName="cuenta" />
    </div>
</header>
<div class="app-shell">
    <aside id="menu-lateral" class="brand-panel @(menuVisible ? "menu-visible" : "")">
        <a class="brand" href="/">SSDAP<span>AGUA POTABLE</span></a>
        <div class="sidebar-navigation"><SectionOutlet SectionName="navegacion" /></div>
    </aside>
    <main id="contenido" tabindex="-1">@Body</main>
</div>
@code { private bool menuVisible; }
<div id="blazor-error-ui" data-nosnippet>
    Se perdió la conexión con la aplicación. <a href="">Recargar</a>
</div>
