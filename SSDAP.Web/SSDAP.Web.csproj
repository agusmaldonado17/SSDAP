<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UserSecretsId>SSDAP-Web-Local</UserSecretsId>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SSDAP.Shared\SSDAP.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json;appsettings.Local.json;appsettings.*.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
